{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recodio",
  "version": "0.1.0",
  "identifier": "com.recodio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Recodio",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Descargador de vídeo y música con yt-dlp y spotDL",
    "longDescription": "Recodio descarga vídeos, playlists y música desde miles de sitios usando yt-dlp y spotDL, con SponsorBlock, detección de duplicados y biblioteca integrada.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
