{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recodio",
  "version": "0.1.0",
  "identifier": "com.recodio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Recodio",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/giver720/Recodio/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFRTM3MzJENTdERjIyREMKUldUY0l0OVhMWFBqUG8zNFRFTEEzZ2JTQStOc1FKV0pvMjRoTW9LblZxNUIzeG54MWdFSUlNSjgK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "createUpdaterArtifacts": true,
    "shortDescription": "Descargador de vídeo y música con yt-dlp y spotDL",
    "longDescription": "Recodio descarga vídeos, playlists y música desde miles de sitios usando yt-dlp y spotDL, con SponsorBlock, detección de duplicados y biblioteca integrada.",
    "linux": {
      "deb": {
        "section": "video",
        "recommends": ["yt-dlp", "ffmpeg", "python3-spotdl", "xdg-utils"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
